# ==============================================================================
# FinFlow Production Environment Configuration
# Copy this file to .env on your VPS and update the values:
#   cp .env.example .env
# ==============================================================================

# Database Settings
POSTGRES_USER=finflow_user
POSTGRES_PASSWORD=change_this_to_a_secure_password_123
POSTGRES_DB=finflow_prod

# Backend API
SECRET_KEY=generate_a_super_random_secret_key_minimum_32_characters
EXCHANGERATE_API_KEY=your_free_or_paid_exchangerate_api_key_here

# Internal & External Ports
PORT=3000
BACKEND_PORT=8000
