# Database Configuration
DATABASE_URL=postgresql://finflow_user:finflow_password@localhost:5432/finflow_db
POSTGRES_USER=finflow_user
POSTGRES_PASSWORD=finflow_password
POSTGRES_DB=finflow_db

# JWT/Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: External APIs
EXCHANGERATE_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
LUNO_API_KEY=

# Broker holdings dashboard — encrypts each broker account's stored credentials.
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored broker credentials unrecoverable (accounts would
# need to be re-added) — back it up somewhere other than this file.
APP_ENCRYPTION_KEY=

# Redis (if using caching)
REDIS_URL=redis://localhost:6379/0

# Frontend (if needed)
NEXT_PUBLIC_API_URL=http://localhost:8000
