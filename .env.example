# ==============================================================================
# FinFlow Environment Configuration
# Copy this file to .env and update the values:
#   cp .env.example .env
# ==============================================================================

# Database Settings
DATABASE_URL=postgresql://finflow_user:finflow_password@localhost:5432/finflow_db
POSTGRES_USER=finflow_user
POSTGRES_PASSWORD=change_this_to_a_secure_password_123
POSTGRES_DB=finflow_prod

# JWT/Security
SECRET_KEY=generate_a_super_random_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: External APIs
EXCHANGERATE_API_KEY=your_free_or_paid_exchangerate_api_key_here
BINANCE_API_KEY=
BINANCE_API_SECRET=
LUNO_API_KEY=

# Broker holdings dashboard — encrypts each broker account's stored credentials.
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored broker credentials unrecoverable (accounts would
# need to be re-added) — back it up somewhere other than this file.
APP_ENCRYPTION_KEY=

# Redis (if using caching)
REDIS_URL=redis://localhost:6379/0

# Frontend (if needed)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal & External Ports
PORT=3000
BACKEND_PORT=8000
